# 复制为 .env 后填写自己的配置，密钥不要提交到代码仓库。
# 推荐：只填写 DEEPSEEK_API_KEY，自动使用 deepseek-flash 和本地向量模型。
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY：用于答案生成与模型判分。
# OPENAI_API_KEY：用于远程向量服务，也可作为问答服务密钥。
# OPENAI_BASE_URL：使用兼容服务时填写其地址，直连官方服务时可省略。
# 无有效密钥时可以使用本地模型检索，不能生成真实答案。
# 本机已有专用 .env；Docker 服务连接由 docker-compose.yml 配置。
OPENROUTER_API_KEY=
RAG_CONFIDENCE_THRESHOLD=0.5
# 本机测试中台的 OTLP 接收地址，例如 http://127.0.0.1:8088/v1/traces。
RAG_TRACE_ENDPOINT=
# 重排模型仓库名或本地模型目录；空值也默认使用下方多语言模型。
# 首次使用需下载模型，本机可填写已下载的模型目录。
RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CHROMA_HOST=
CHROMA_PORT=8000
# auto：无密钥时纯检索，有密钥时默认生成回答。
RAG_RETRIEVAL_ONLY=auto
